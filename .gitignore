coverage.xml
htmlcov/

# --- Local data ------------------------------------------------------------
# DB dumps and local databases may hold patient data; never commit them.
*.log
pgdata/
dump.rdb
*.sqlite
*.sqlite3
*.dump
*.sql.gz
