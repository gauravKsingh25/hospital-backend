# --- Secrets ---------------------------------------------------------------
# Every .env variant. Only the documented template is committed.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
